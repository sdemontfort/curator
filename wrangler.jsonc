{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "asx-curator",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Hourly cron to refresh articles
  "triggers": {
    "crons": ["0 * * * *"]
  }
}
